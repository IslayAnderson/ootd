# Copy to .env.docker and fill in. Keep it private: it holds your database password and PWD_SEED.

# The address people will use, with https://. Public links and federation ids are built from it,
# so don't change it once the site is shared.
APP_URL=https://ootd.example

# Peppers every password. Generate once with `openssl rand -hex 32` and never change it.
PWD_SEED=

DB_SCHEMA=ootd
DB_USER=ootd
DB_PASS=

# The first admin, created on first start. Leave the password empty to have one generated and
# printed in `docker compose logs web`.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ootd.example
ADMIN_PASSWORD=

# Email for password resets and invites (any SMTP provider). The image has no sendmail, so without
# MAIL_HOST emails are only written to tmp/mail.log.
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=

# Photos are kept in the "media" volume. To use Cloudflare R2 (or another S3-compatible store) instead,
# see docs/SELF-HOSTING.md, then check it with: docker compose exec web php bin/ootd storage:check
# MEDIA_DRIVER=s3
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_KEY=
# S3_SECRET=
# For AWS: S3_ENDPOINT=https://s3.eu-west-2.amazonaws.com and S3_REGION=eu-west-2
